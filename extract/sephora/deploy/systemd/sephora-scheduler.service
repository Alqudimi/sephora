# ─────────────────────────────────────────────────────────────────
# SEPHORA UAE — scheduler (systemd alternative to the cron entry)
# Install:
#   sudo cp deploy/systemd/sephora-scheduler.service  /etc/systemd/system/
#   sudo cp deploy/systemd/sephora-scheduler.timer    /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now sephora-scheduler.timer
# ─────────────────────────────────────────────────────────────────

[Unit]
Description=Sephora UAE task scheduler runner

[Service]
Type=oneshot
User=www-data
Group=www-data
ExecStart=/usr/bin/php /var/www/sephora/artisan schedule:run
