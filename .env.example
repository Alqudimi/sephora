APP_NAME="Sephora UAE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# ── HTTPS behind a reverse proxy (enable in production) ──
# APP_FORCE_HTTPS=true
# TRUSTED_PROXIES="127.0.0.1,::1"

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database — SQLite for local/demo, MySQL in production (see DEPLOYMENT.md)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sephora
# DB_USERNAME=sephora
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — order confirmations are queued and sent through this transport.
# "log" writes emails to storage/logs/laravel.log (safe default for local).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="orders@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─────────────────────────────────────────────────────────────────
# Payments
# ─────────────────────────────────────────────────────────────────
# fake  = simulated payments (local/demo/testing — no real charges)
# stripe= live Stripe Checkout (card + Apple Pay)
PAYMENTS_DRIVER=fake
# PAYMENTS_FAKE_AUTO_SUCCEED=true
# STRIPE_SECRET=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_BASE_URL=https://api.stripe.com
# STRIPE_SUCCESS_URL=https://your-domain.com/checkout/success
# STRIPE_CANCEL_URL=https://your-domain.com/checkout

# ZainCash Gateway (Iraq IQD wallet — configure here or via Admin Panel Settings)
ZAINCASH_ENABLED=false
ZAINCASH_MODE=uat
ZAINCASH_API_VERSION=v2
ZAINCASH_CLIENT_ID=
ZAINCASH_CLIENT_SECRET=
ZAINCASH_MERCHANT_ID=
ZAINCASH_SECRET=
ZAINCASH_MSISDN=
ZAINCASH_EXCHANGE_RATE=355.0
ZAINCASH_LANG=ar

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────
# Application settings (optional overrides)
# ─────────────────────────────────────────────────────────────────
# Free shipping threshold & flat fee (AED) — DB `settings` table wins when set:
#   php artisan tinker --execute="\App\Models\Setting::set('free_shipping_threshold', 250);"
#   php artisan tiger --execute="\App\Models\Setting::set('shipping_fee', 25);"
# Admin new-order alert email (optional; DB `settings` key):
#   \App\Models\Setting::set('admin_notify_email', 'orders@yourdomain.com');
